#============================================================================
# Name        : Check.MIA
# Author      : Antonius Torode
# Created on  : 10/23/2025
# Description : MIA config for the CHECK application.
#============================================================================

# Create a commented line using the '#' character. 
# Comments must be on their own line.
# This file must be of the proper format to work with MIA.
# Create a setting parameter using 'settingVariable=value'.
# Do not include spaces unless within a string variable. 
# This means, do not do 'variable= text' unless you intend to have " text" be the variable value.

# Misc Options.
verbose_mode=true
show_legal_moves=true

# Defines the board size.
board_size_x=4
board_size_y=5

# Player state to start.
number_of_players=2
whos_turn_is_it=1

#============================================================================
# Starting board state (position).
# Exactly one 'starting_state' line must be active (uncommented). To use one
# of the test scenarios below, comment out the active starting_state line and
# uncomment the desired scenario. All scenarios use the 4x5 board above and
# leave white to move (whos_turn_is_it=1).
# Coordinate system: (x,y) where x is the column (0 = left edge, increasing
# right) and y is the row (0 = white home rank, increasing toward black).
#============================================================================

# Config using one of each minor piece type - mirrored position.
starting_state=0,0,rook,white;1,0,bishop,white;2,0,knight,white;3,0,king,white;0,1,pawn,white;1,1,pawn,white;2,1,pawn,white;3,1,pawn,white;0,4,rook,black;1,4,bishop,black;2,4,knight,black;3,4,king,black;0,3,pawn,black;1,3,pawn,black;2,3,pawn,black;3,3,pawn,black

# Config using one of each minor piece type - opposite position.
#starting_state=0,0,rook,white;1,0,bishop,white;2,0,knight,white;3,0,king,white;0,1,pawn,white;1,1,pawn,white;2,1,pawn,white;3,1,pawn,white;3,4,rook,black;2,4,bishop,black;1,4,knight,black;0,4,king,black;0,3,pawn,black;1,3,pawn,black;2,3,pawn,black;3,3,pawn,black